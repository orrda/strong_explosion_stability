  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\nClear[G, P]\n\n\n(* The M matrix*)\n\nMM00 = \\[Xi] (U - 1);\nMM01 = G \\[Xi];\nMM02 = 0;\nMM03 = 0;\n\n\nMM10 = 0;\nMM11 = \\[Xi]^2 (U - 1) G;\nMM12 = 0;\nMM13 = 1;\n\n\nMM20 = 0;\nMM21 = 0;\nMM22 = \\[Xi]^2 (U - 1) G;\nMM23 = 0;\n\n\nMM30 = - \\[Gamma] \\[Xi] (U - 1) / G;\nMM31 = 0;\nMM32 = 0;\nMM33 = \\[Xi] (U - 1)/P;\n\n\n(* The N matrix*)\n\nNN00 = \\[Omega] - q - 3U - \\[Xi] dUdx;\nNN01 = -\\[Xi] dGdx - 3G;\nNN02 = l(l+1) G;\nNN03 = 0;\n\n\nNN10 = dPdx/G;\nNN11 = (1 - \\[Delta] - q - 2U - \\[Xi] dUdx) G \\[Xi];\nNN12 = 0;\nNN13 = 0;\n\n\nNN20 = 0;\nNN21 = 0;\nNN22 = (1 - \\[Delta] - q - 2U) G \\[Xi];\nNN23 = -1/\\[Xi];\n\n\nNN30 = \\[Gamma] q / G - \\[Gamma] (U - 1) \\[Xi] dGdx /(G^2);\nNN31 = \\[Gamma] \\[Xi] dGdx / G;\nNN32 = 0;\nNN33 = \\[Xi] (U - 1) dPdx / (P^2) - q/P;\n\n\nMM = {{MM00, MM01, MM02, MM03},\n      {MM10, MM11, MM12, MM13},\n      {MM20, MM21, MM22, MM23},\n      {MM30, MM31, MM32, MM33}};\n\nNN = {{NN00, NN01, NN02, NN03},\n      {NN10, NN11, NN12, NN13},\n      {NN20, NN21, NN22, NN23},\n      {NN30, NN31, NN32, NN33}};\n\nMatrixForm[MM];\nMatrixForm[NN];\n\nInvMM = Inverse[MM];\n\nA = InvMM . NN;\n\nA = Simplify[A];\nMatrixForm[A]\n\n\n",
   "languageId": "wolfram",
