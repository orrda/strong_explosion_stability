  {
   "kind": 2,
   "value": "S = {\n    {(\\[Xi] - \\[Xi]0)^(\\[Theta]1),0,0,0},\n    {0,(\\[Xi] - \\[Xi]0)^(\\[Theta]2),0,0},\n    {0,0,(\\[Xi] - \\[Xi]0)^(\\[Theta]3),0},\n    {0,0,0,(\\[Xi] - \\[Xi]0)^(\\[Theta]4)}\n};\n\nMatrixForm[S];\n\nSinv = Inverse[S];\n\nMatrixForm[Sinv];\n\nS' = D[S, \\[Xi]];\n\nMatrixForm[S'];\n\nH = \\[Xi] ( Sinv . A . S - Sinv . S');\nMatrixForm[H];\n\n\n",
