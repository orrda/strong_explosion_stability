     ],
     "id": "35fcaea3-436c-4178-964f-c199c3110775",
     "metadata": {
      "cellLabel": "Out[660]//MatrixForm= ",
      "isBoxData": false
     }
    }
   ],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "TeXForm[expmat]\r\n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* Parameters *)\r\n\r\nClearAll[\"Global`*\"]\r\n\r\n\r\nMM11 = \\[Xi]*(U - 1);\r\nMM12 = \\[Xi]*G;\r\nMM13 = 0;\r\nMM14 = 0;\r\nMM21 = 0;\r\nMM22 = (U - 1)*(\\[Xi]^2)*G;\r\nMM23 = 0;\r\nMM24 = 1;\r\nMM31 = 0;\r\nMM32 = 0;\r\nMM33 = (U - 1)*(\\[Xi]^2)*G;\r\nMM34 = 0;\r\nMM41 = -\\[Gamma]*\\[Xi]*(U - 1)/G;\r\nMM42 = 0;\r\nMM43 = 0;\r\nMM44 = \\[Xi]*(U - 1)/P;\r\n\r\n\r\nMMM = {{MM11, MM12, MM13, MM14}, {MM21, MM22, MM23, MM24}, {MM31, MM32, MM33, \r\n    MM34}, {MM41, MM42, MM43, MM44}};\r\n\r\nMMM // MatrixForm\r\ninvMMM = Inverse[MMM];\r\ninvMMM = Simplify[invMMM];\r\ninvMMM = FullSimplify[invMMM];\r\ninvMMM // MatrixForm\r\n\r\n\r\n\r\n\r\nGG = \\[Theta]* G0 * x^(\\[Theta] - 1);\r\n\r\n\\[Delta] = 0;\r\n\r\nNN11 = \\[Omega] - q - 3*U - \\[Xi]*U0;\r\nNN12 = -\\[Xi]*GG - 3*G;\r\nNN13 = l*(l + 1)*G;\r\nNN14 = 0;\r\nNN21 = 0;\r\nNN22 = \\[Xi]*G*(1 - \\[Delta] - q - 2*U - \\[Xi]*U0);\r\nNN23 = 0;\r\nNN24 = 0;\r\nNN31 = 0;\r\nNN32 = 0;\r\nNN33 = \\[Xi]*G*(1 - \\[Delta] - q - 2*U);\r\nNN34 = -1/\\[Xi];\r\nNN41 = (\\[Gamma]/G)*(q - \\[Xi]*(U - 1)*GG/G);\r\nNN42 = \\[Xi]*\\[Gamma]*GG/G;\r\nNN43 = 0;\r\nNN44 = - q/P;\r\n\r\nNNN = {{NN11, NN12, NN13, NN14}, {NN21, NN22, NN23, NN24}, {NN31, NN32, NN33, \r\n    NN34}, {NN41, NN42, NN43, NN44}};\r\n\r\nNNN // MatrixForm;\r\nmatrix = invMMM . NNN;\r\nmatrix = Simplify[matrix];\r\nmatrix = FullSimplify[matrix];\r\nmatrix // MatrixForm\r\nTextForm[matrix]\r\n\r\n\r\n",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wrow><w></w><wb>(</wb><w>⁠</w><wgrid style=\"grid-template-columns:repeat(4,max-content);\"><w><wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><w>U</w></wrow><wb>)</wb></wrow><w></w><w>ξ</w></wrow></w><w><wrow><w></w><w>G</w><w></w><w>ξ</w></wrow></w><w><w>0</w></w><w><w>0</w></w><w><w>0</w></w><w><wrow><w></w><w>G</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><w>U</w></wrow><wb>)</wb></wrow><w></w><wsup><w></w><w>ξ</w><w><w>2</w></w></wsup></wrow></w><w><w>0</w></w><w><w>1</w></w><w><w>0</w></w><w><w>0</w></w><w><wrow><w></w><w>G</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><w>U</w></wrow><wb>)</wb></wrow><w></w><wsup><w></w><w>ξ</w><w><w>2</w></w></wsup></wrow></w><w><w>0</w></w><w><wrow><w></w><w>-</w><wfrac><w><wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><w>U</w></wrow><wb>)</wb></wrow><w></w><w>γ</w><w></w><w>ξ</w></wrow></w><w><w></w><w><w>G</w></w></w></wfrac></wrow></w><w><w>0</w></w><w><w>0</w></w><w><wfrac><w><wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><w>U</w></wrow><wb>)</wb></wrow><w></w><w>ξ</w></wrow></w><w><w></w><w><w>P</w></w></w></wfrac></w></wgrid><w>⁠</w><wb>)</wb></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "MatrixForm[{{(-1 + U)*ξ, G*ξ, 0, 0}, {0, G*(-1 + U)*ξ^2, 0, 1}, {0, 0, G*(-1 + U)*ξ^2, 0}, {-(((-1 + U)*γ*ξ)/G), 0, 0, ((-1 + U)*ξ)/P}}]",
       "mime": "text/plain"
      }
     ],
