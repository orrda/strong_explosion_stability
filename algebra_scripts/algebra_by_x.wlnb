       "data": "<div class=\"wexpr\"><wrow><w></w><wb>(</wb><w>⁠</w><wgrid style=\"grid-template-columns:repeat(4,max-content);\"><w><wrow><w></w><w>ξ</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><wrow><w></w><w>U</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></wrow><wb>)</wb></wrow></wrow></w><w><wrow><w></w><w>ξ</w><w></w><wrow><w></w><w>G</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></wrow></w><w><w>0</w></w><w><w>0</w></w><w><w>0</w></w><w><wrow><w></w><wsup><w></w><w>ξ</w><w><w>2</w></w></wsup><w></w><wrow><w></w><w>G</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><wrow><w></w><w>U</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></wrow><wb>)</wb></wrow></wrow></w><w><w>0</w></w><w><w>1</w></w><w><w>0</w></w><w><w>0</w></w><w><wrow><w></w><wsup><w></w><w>ξ</w><w><w>2</w></w></wsup><w></w><wrow><w></w><w>G</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><wrow><w></w><w>U</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></wrow><wb>)</wb></wrow></wrow></w><w><w>0</w></w><w><wrow><w></w><w>-</w><wfrac><w><wrow><w></w><w>γ</w><w></w><w>ξ</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><wrow><w></w><w>U</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></wrow><wb>)</wb></wrow></wrow></w><w><w></w><w><wrow><w></w><w>G</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></w></w></wfrac></wrow></w><w><w>0</w></w><w><w>0</w></w><w><wfrac><w><wrow><w></w><w>ξ</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><wrow><w></w><w>U</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></wrow><wb>)</wb></wrow></wrow></w><w><w></w><w><wrow><w></w><w>P</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></w></w></wfrac></w></wgrid><w>⁠</w><wb>)</wb></wrow></div>",
       "mime": "x-application/wolfram-language-html"
