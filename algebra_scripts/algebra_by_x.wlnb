</w><wrow><w></w><w>-</w><w>P0</w></wrow><w></w><w>U0</w><w></w><wsup><w></w><w>x</w><w><wfrac class=\"script\"><w><wrow><w></w><wrow><w></w><wrow><w></w><w>-</w><w>2</w></wrow><w></w><w>ω</w></wrow><w>+</w><wrow><w></w><w>γ</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><w>3</w><w>+</w><w>ω</w></wrow><wb>)</wb></wrow></wrow></wrow></w><w><w></w><w><wrow><w></w><wrow><w></w><w>3</w><w></w><w>γ</w></wrow><w>-</w><w>ω</w></wrow></w></w></wfrac></w></wsup><w></w><w>γ</w><w></w><w>ξ</w></wrow><w>+</w><wrow><w></w><w>G0</w><w></w><wsup><w></w><w>U0</w><w><w>3</w></w></wsup><w></w><wsup><w></w><w>x</w><w><w>3</w></w></wsup><w></w><wsup><w></w><w>ξ</w><w><w>3</w></w></wsup></wrow></wrow></w></w></wfrac></w><w><wrow><w></w><w>-</w><wfrac><w><wrow><w></w><w>P0</w><w></w><wsup><w></w><w>x</w><w><wfrac class=\"script\"><w><wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><w>γ</w></wrow><wb>)</wb></wrow><w></w><w>ω</w></wrow></w><w><w></w><w><wrow><w></w><wrow><w></w><w>3</w><w></w><w>γ</w></wrow><w>-</w><w>ω</w></wrow></w></w></wfrac></w></wsup><w></w><w>γ</w></wrow></w><w><w></w><w><wrow><w></w><w>G0</w><w></w><w>ξ</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><wrow><w></w><w>-</w><w>P0</w></wrow><w></w><w>γ</w></wrow><w>+</w><wrow><w></w><w>G0</w><w></w><wsup><w></w><w>U0</w><w><w>2</w></w></wsup><w></w><wsup><w></w><w>x</w><w><wrow><w></w><w>1</w><w>+</w><w>γ</w><w>+</w><wfrac class=\"script\"><w><wrow><w></w><w>3</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><w>γ</w></wrow><wb>)</wb></wrow><w></w><w>γ</w></wrow></w><w><w></w><w><wrow><w></w><wrow><w></w><wrow><w></w><w>-</w><w>3</w></wrow><w></w><w>γ</w></wrow><w>+</w><w>ω</w></wrow></w></w></wfrac></wrow></w></wsup><w></w><wsup><w></w><w>ξ</w><w><w>2</w></w></wsup></wrow></wrow><wb>)</wb></wrow></wrow></w></w></wfrac></wrow></w><w><wfrac><w><wrow><w></w><w>U0</w><w></w><w>x</w></wrow></w><w><w></w><w><wrow><w></w><wrow><w></