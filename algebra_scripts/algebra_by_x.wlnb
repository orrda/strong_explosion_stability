     "items": [
      {
       "data": "<div class=\"wexpr\"><wrow><w></w><wb>(</wb><w>⁠</w><wrow><w></w><w>≪</w><w>1</w><w>≫</w></wrow><w>⁠</w><wb>)</wb></wrow></div>",
