{
 "cells": [
  {
   "kind": 2,
   "value": "\\[Gamma] = 5/3;\r\n\\[Omega] = 4.25;\r\n\\[Delta] = 0.25;\r\n\r\n\r\n\r\nDelta = CC[\\[Xi]]^2 - (1 - UU[\\[Xi]])^2\r\nDelta1 = UU[\\[Xi]] * (1 - UU[\\[Xi]]) * (1 - UU[\\[Xi]] - \\[Delta]) - CC[\\[Xi]]^2 * (3 * UU[\\[Xi]] + (2 * \\[Delta] - \\[Omega])/\\[Gamma])\r\nDelta2 = CC[\\[Xi]]*(1 - UU[\\[Xi]])*(1 - UU[\\[Xi]] - \\[Delta]) - ((\\[Gamma] - 1)/2)*CC[\\[Xi]]*UU[\\[Xi]]*(2 - 2*UU[\\[Xi]] + \\[Delta]) - CC[\\[Xi]]^2 + ((2*\\[Delta] + (\\[Gamma] - 1)*\\[Omega])/(2*\\[Gamma]))*CC[\\[Xi]]^3/(1 - UU[\\[Xi]])\r\n\r\nDSolve[{\r\n    UU'[\\[Xi]] == Delta1/(Delta * \\[Xi]), \r\n    CC'[\\[Xi]] == Delta2/(Delta * \\[Xi]), \r\n    UU[1] == 2/(\\[Gamma] + 1), \r\n    CC[1] == Sqrt[2*\\[Gamma] * (\\[Gamma] - 1)]/(\\[Gamma] + 1)\r\n}, {UU[\\[Xi]], CC[\\[Xi]]}, \\[Xi]]\r\n",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wrow><w></w><wsup><w></w><wrow><w></w><w>CC</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow><w><w>2</w></w></wsup><w>-</w><wsup><w></w><wrow><w></w><wb>(</wb><wrow><w></w><w>1</w><w>-</w><wrow><w></w><w>UU</w><wrow><w></w><wb>[</wb><w>ξ</w><wb>]</wb></wrow></wrow></wrow><wb>)</wb></wrow><w><w>2</w></w></wsup></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
