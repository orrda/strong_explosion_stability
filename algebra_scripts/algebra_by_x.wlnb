       "data": "MatrixForm[{{(G0*U0*ξ)/(x^((γ*(-3 + ω))/(3*γ - ω))*(-(P0*γ) + G0*U0^2*x^(1 + γ + (3*(-1 + γ)*γ)/(-3*γ + ω))*ξ^2)), G0/(P0*x^(((-1 + γ)*ω)/(3*γ - ω))*γ - G0*U0^2*x^2*ξ^2), 0, (G0*P0)/(-(P0*U0*x^((-2*ω + γ*(3 + ω))/(3*γ - ω))*γ*ξ) + G0*U0^3*x^3*ξ^3)}, {-((P0*x^(((-1 + γ)*ω)/(3*γ - ω))*γ)/(G0*ξ*(-(P0*γ) + G0*U0^2*x^(1 + γ + (3*(-1 + γ)*γ)/(-3*γ + ω))*ξ^2))), (U0*x)/(-(P0*γ) + G0*U0^2*x^(1 + γ + (3*(-1 + γ)*γ)/(-3*γ + ω))*ξ^2), 0, P0/(P0*γ*ξ - G0*U0^2*x^(1 + γ + (3*(-1 + γ)*γ)/(-3*γ + ω))*ξ^3)}, {0, 0, x^((γ*(-3 + ω))/(3*γ - ω))/(G0*U0*ξ^2), 0}, {(P0*U0*x*γ*ξ)/(-(P0*γ) + G0*U0^2*x^(1 + γ + (3*(-1 + γ)*γ)/(-3*γ + ω))*ξ^2), (P0*γ)/(P0*γ - G0*U0^2*x^(1 + γ + (3*(-1 + γ)*γ)/(-3*γ + ω))*ξ^2), 0, (G0*P0*U0*ξ)/(x^((γ*(-3 + ω))/(3*γ - ω))*(-(P0*γ) + G0*U0^2*x^(1 + γ + (3*(-1 + γ)*γ)/(-3*γ + ω))*ξ^2))}}]",
