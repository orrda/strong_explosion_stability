  {
   "kind": 2,
   "value": "dett2 = ReplaceAll[dett1, {\\[Omega] -> 3, \\[Gamma] -> 5/3, A -> 1, \\[Phi] -> 1}];\r\ndett2 = Simplify[dett2];\r\ndett2 = FullSimplify[dett2];\r\n\r\n\r\nLs24 = Coefficient[dett2, C, -24];\r\nLs23 = Coefficient[dett2, C, -23];\r\nLs22 = Coefficient[dett2, C, -22];\r\nLs21 = Coefficient[dett2, C, -21];\r\nLs20 = Coefficient[dett2, C, -20];\r\nLs19 = Coefficient[dett2, C, -19];\r\nLs18 = Coefficient[dett2, C, -18];\r\nLs17 = Coefficient[dett2, C, -17];\r\nLs16 = Coefficient[dett2, C, -16];\r\nLs15 = Coefficient[dett2, C, -15];\r\nLs14 = Coefficient[dett2, C, -14];\r\nLs13 = Coefficient[dett2, C, -13];\r\nLs12 = Coefficient[dett2, C, -12];\r\nLs11 = Coefficient[dett2, C, -11];\r\nLs10 = Coefficient[dett2, C, -10];\r\nLs9 = Coefficient[dett2, C, -9];\r\nLs8 = Coefficient[dett2, C, -8];\r\nLs7 = Coefficient[dett2, C, -7];\r\nLs6 = Coefficient[dett2, C, -6];\r\nLs5 = Coefficient[dett2, C, -5];\r\nLs4 = Coefficient[dett2, C, -4];\r\nLs3 = Coefficient[dett2, C, -3];\r\nLs2 = Coefficient[dett2, C, -2];\r\nLs1 = Coefficient[dett2, C, -1];\r\nLs0 = Coefficient[dett2, C, 0];\r\nLs0 = Simplify[Ls0];\r\nLs0 = FullSimplify[Ls0]\r\nLss1 = Coefficient[dett2, C, 1];\r\nLss2 = Coefficient[dett2, C, 2];\r\nLss3 = Coefficient[dett2, C, 3];\r\nLss4 = Coefficient[dett2, C, 4];\r\nLss5 = Coefficient[dett2, C, 5];\r\nLss6 = Coefficient[dett2, C, 6];\r\nLss7 = Coefficient[dett2, C, 7];\r\nLss8 = Coefficient[dett2, C, 8];\r\nLss9 = Coefficient[dett2, C, 9];\r\n\r\n\r\nsolB = Solve[Ls0 == 0, B]\r\nsolB = ReplaceAll[solB, {\\[Xi] -> 0.3}]\r\nsolB1 = solB[[3]]\r\nsolB2 = solB[[4]]\r\n\r\nPlot[Re[B /. solB1], {q, -1, 1}]\r\nPlot[Im[B /. solB1], {q, -1, 1}]\r\n\r\nPlot[Re[B /. solB2], {q, -1, 1}]\r\nPlot[Im[B /. solB2], {q, -1, 1}]\r\n\r\n",
