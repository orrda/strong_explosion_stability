   "value": "coeff4S4 = Coefficient[detrer4S, C, -4];\r\ncoeff4S4 = Simplify[coeff4S4];\r\ncoeff4S4 = FullSimplify[coeff4S4];\r\ncoeff4S2 = Coefficient[detrer4S, C, -2];\r\ncoeff4S2 = Simplify[coeff4S2];\r\ncoeff4S2 = FullSimplify[coeff4S2]\r\n\r\ncoeff46 = Coefficient[detrer4, C, -6];\r\ncoeff46 = Simplify[coeff46];\r\ncoeff46 = FullSimplify[coeff46];\r\ncoeff44 = Coefficient[detrer4, C, -4];\r\ncoeff44 = Simplify[coeff44];\r\ncoeff44 = FullSimplify[coeff44]\r\ncoeff42 = Coefficient[detrer4, C, -2];\r\n\r\ncoeff5S4 = Coefficient[detrer5S, C, -4];\r\ncoeff5S4 = Simplify[coeff5S4];\r\ncoeff5S4 = FullSimplify[coeff5S4];\r\ncoeff5S2 = Coefficient[detrer5S, C, -2];\r\ncoeff5S2 = Simplify[coeff5S2];\r\ncoeff5S2 = FullSimplify[coeff5S2]\r\n\r\ncoeff56 = Coefficient[detrer5, C, -6];\r\ncoeff56 = Simplify[coeff56];\r\ncoeff56 = FullSimplify[coeff56];\r\ncoeff54 = Coefficient[detrer5, C, -4];\r\ncoeff54 = Simplify[coeff54];\r\ncoeff54 = FullSimplify[coeff54]\r\ncoeff52 = Coefficient[detrer5, C, -2];\r\n\r\n\r\nsol4S2 = Solve[{coeff4S2 == 0}, e];\r\nsol4S2 = Simplify[sol4S2];\r\nsol4S2 = FullSimplify[sol4S2]\r\n\r\nsol44 = Solve[{coeff44 == 0}, e];\r\nsol44 = Simplify[sol44];\r\nsol44 = FullSimplify[sol44]\r\n\r\nsol5S2 = Solve[{coeff5S2 == 0}, e];\r\nsol5S2 = Simplify[sol5S2];\r\nsol5S2 = FullSimplify[sol5S2]\r\n\r\nsol54 = Solve[{coeff54 == 0}, e];\r\nsol54 = Simplify[sol54];\r\nsol54 = FullSimplify[sol54]\r\n\r\nsol4S = Solve[{coeff4S4 == 0, coeff4S2 == 0}, {e, q}];\r\n\r\nsol4 = Solve[{coeff46 == 0, coeff44 == 0}, {e, q}];\r\n\r\nsol5S = Solve[{coeff5S4 == 0, coeff5S2 == 0}, {e, q}];\r\n\r\nsol5 = Solve[{coeff56 == 0, coeff54 == 0}, {e, q}];\r\n\r\nsol56 = Solve[{coeff56 == 0}, q];\r\nPlot[Re[q /. sol56], {\\[Xi], 0, 1}, PlotRange -> All]\r\nPlot[Im[q /. sol56], {\\[Xi], 0, 1}, PlotRange -> All]\r\n\r\nsolS54 = Solve[{coeff5S4 == 0}, q];\r\nPlot[Re[q /. solS54], {\\[Xi], 0, 1}, PlotRange -> All]\r\nPlot[Im[q /. solS54], {\\[Xi], 0, 1}, PlotRange -> All]\r\n\r\n",
