      {
       "data": "{{e -> (-10*q*(1 + q)*(7 + 5*q)*ξ + 3*(17 + 39*q + 30*q^2)*ξ^2 - 18*(1 + 2*q)*ξ^3 + Sqrt[ξ^2*((10*q*(1 + q)*(7 + 5*q) - 3*(17 + 39*q + 30*q^2)*ξ + 18*(1 + 2*q)*ξ^2)^2 + 5*(1 + q)*(5*q - 6*ξ)*(25*q*(1 + q)*(-4 + l + l^2 + (-7 + q)*q) - 6*(-2 + 2*l*(1 + l) - 39*q + 10*l*(1 + l)*q - 43*q^2 + 10*q^3)*ξ + 36*(-1 + l + l^2 + (-2 + q)*q)*ξ^2))])/(5*(1 + q)*(5*q - 6*ξ)*ξ^2)}, {e -> -1/5*(10*q*(1 + q)*(7 + 5*q)*ξ - 3*(17 + 39*q + 30*q^2)*ξ^2 + 18*(1 + 2*q)*ξ^3 + Sqrt[ξ^2*((10*q*(1 + q)*(7 + 5*q) - 3*(17 + 39*q + 30*q^2)*ξ + 18*(1 + 2*q)*ξ^2)^2 + 5*(1 + q)*(5*q - 6*ξ)*(25*q*(1 + q)*(-4 + l + l^2 + (-7 + q)*q) - 6*(-2 + 2*l*(1 + l) - 39*q + 10*l*(1 + l)*q - 43*q^2 + 10*q^3)*ξ + 36*(-1 + l + l^2 + (-2 + q)*q)*ξ^2))])/((1 + q)*(5*q - 6*ξ)*ξ^2)}}",
       "mime": "text/plain"
      }
