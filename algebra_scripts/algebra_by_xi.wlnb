       "data": "\"\\\\left(\\n\\\\begin{array}{cccc}\\n \\\\frac{\\\\xi  (U-1) \\\\left(G \\\\left(-G \\\\xi ^2 (U-1) U'-P'\\\\right)-\\\\gamma  P G'\\\\right)+G \\\\left(\\\\gamma  P q-G \\\\xi ^2 (U-1)^2 (q+3 U-\\\\omega )\\\\right)}{G \\\\xi  (U-1) \\\\left(G \\\\xi ^2 (U-1)^2-\\\\gamma  P\\\\right)} & \\\\frac{G^2 \\\\xi  (U-1) \\\\left(\\\\delta +q+\\\\xi  U'-U+2\\\\right)+G' \\\\left(\\\\gamma  P-G \\\\xi ^2 (U-1)^2\\\\right)}{G \\\\xi ^2 (U-1)^3+P (\\\\gamma -\\\\gamma  U)} & \\\\frac{G^2 l (l+1) \\\\xi  (U-1)}{G \\\\xi ^2 (U-1)^2-\\\\gamma  P} & \\\\frac{G \\\\left(\\\\xi  (U-1) P'-P q\\\\right)}{P \\\\left(G \\\\xi ^3 (U-1)^3-\\\\gamma  \\\\xi  P (U-1)\\\\right)} \\\\\\\\\\n \\\\frac{\\\\gamma  \\\\xi  P (U-1) G'+G \\\\xi  (U-1) P'+\\\\gamma  G P \\\\left(\\\\xi  U'+3 U-\\\\omega \\\\right)}{G^2 \\\\left(G \\\\xi ^3 (U-1)^2-\\\\gamma  \\\\xi  P\\\\right)} & \\\\frac{G \\\\xi ^2 (U-1) (\\\\delta +q+2 U-1)+G \\\\xi ^3 (U-1) U'-3 \\\\gamma  P}{\\\\gamma  \\\\xi  P-G \\\\xi ^3 (U-1)^2} & \\\\frac{\\\\gamma  l (l+1) P}{\\\\gamma  \\\\xi  P-G \\\\xi ^3 (U-1)^2} & \\\\frac{\\\\xi  (U-1) P'-P q}{\\\\xi  P \\\\left(\\\\gamma  P-G \\\\xi ^2 (U-1)^2\\\\right)} \\\\\\\\\\n 0 & 0 & -\\\\frac{\\\\delta +q+2 U-1}{\\\\xi  (U-1)} & \\\\frac{1}{G \\\\xi ^3-G \\\\xi ^3 U} \\\\\\\\\\n -\\\\frac{\\\\gamma  P \\\\left(\\\\xi ^2 (U-1)^2 G'+G \\\\xi  (U-1) \\\\left(\\\\xi  U'+3 U-\\\\omega \\\\right)+P'\\\\right)}{G \\\\left(G \\\\xi ^2 (U-1)^2-\\\\gamma  P\\\\right)} & \\\\frac{\\\\gamma  G \\\\xi  P \\\\left(\\\\delta +q+\\\\xi  U'-U+2\\\\right)}{G \\\\xi ^2 (U-1)^2-\\\\gamma  P} & \\\\frac{\\\\gamma  G l (l+1) \\\\xi  P (U-1)}{G \\\\xi ^2 (U-1)^2-\\\\gamma  P} & \\\\frac{G \\\\xi  (U-1) \\\\left(P' (\\\\xi -\\\\xi  U)+P q\\\\right)}{P \\\\left(\\\\gamma  P-G \\\\xi ^2 (U-1)^2\\\\right)} \\\\\\\\\\n\\\\end{array}\\n\\\\right)\\n\"",
