       "data": "MatrixForm[{{(G*(-1 + U)*ξ)/(-(P*γ) + G*(-1 + U)^2*ξ^2), -(G/(-(P*γ) + G*(-1 + U)^2*ξ^2)), 0, (G*P)/(-(P*(-1 + U)*γ*ξ) + G*(-1 + U)^3*ξ^3)}, {-((P*γ)/(G*ξ*(-(P*γ) + G*(-1 + U)^2*ξ^2))), (-1 + U)/(-(P*γ) + G*(-1 + U)^2*ξ^2), 0, P/(P*γ*ξ - G*(-1 + U)^2*ξ^3)}, {0, 0, 1/(G*(-1 + U)*ξ^2), 0}, {-((P*(-1 + U)*γ*ξ)/(P*γ - G*(-1 + U)^2*ξ^2)), (P*γ)/(P*γ - G*(-1 + U)^2*ξ^2), 0, (G*P*(-1 + U)*ξ)/(-(P*γ) + G*(-1 + U)^2*ξ^2)}}]",
